				"support.constant.color"
			],
			"settings": {
				"foreground": "#FFAB70"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#848D97",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"meta.separator.markdown"
			],
			"settings": {
				"foreground": "#848D97"
			}
		},
		{
			"scope": [
				"variable.other.normal.shell",
				"punctuation.definition.variable.shell",
				"variable.other.special.shell"
			],
			"settings": {
				"foreground": "#79B8FF"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#F97583",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#E6CF6A",
				"fontStyle": "strikethrough"
			}
		}
	],
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"variable": "#C5C8CC",
		"property": "#C5C8CC",
		"namespace": "#C5C8CC",
		"variable.readonly": "#79B8FF",
		"enumMember": "#79B8FF",
		"parameter": "#FF9800",
		"function": "#B392F0",
		"method": "#B392F0",
		"class": "#B392F0",
		"type": "#B392F0",
		"interface": "#B392F0",
		"enum": "#B392F0",
		"typeParameter": "#B392F0",
		"keyword": "#F97583",
		"string": "#FFAB70",
		"number": "#D4D4D4",
		"decorator": "#79B8FF",
		"macro": "#B392F0",
		"lifetime": {
			"foreground": "#FF9800",
			"italic": true
		},
		"selfKeyword": {
			"foreground": "#79B8FF",
			"italic": true
		},
		"selfParameter": {
			"foreground": "#79B8FF",
			"italic": true
		},
		"builtinType": "#79B8FF"
	}
